{
  "name": "element-evolution",
  "version": "0.2.0",
  "main": "index.ts",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "sim": "tsc --ignoreConfig sim/sim.ts src/game/*.ts --outDir .sim-out --module commonjs --target es2022 --esModuleInterop --skipLibCheck --moduleResolution bundler --strict && node .sim-out/sim/sim.js"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
